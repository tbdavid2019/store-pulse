{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-pulse",
  "account_id": "379570860738dd1757ba7f67ef2bdffe",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "STORE_PULSE_ENABLE_ANALYSIS": "true",
    "STORE_PULSE_CACHE_TTL_SECONDS": "21600",
    "STORE_PULSE_EMPTY_CACHE_TTL_SECONDS": "600",
    "STORE_PULSE_CLIENT_RATE_LIMIT": "5",
    "STORE_PULSE_DAILY_MODEL_BUDGET": "100",
    "STORE_PULSE_API_ORIGINS": "",
    "CLOUDFLARE_ACCOUNT_ID": "379570860738dd1757ba7f67ef2bdffe"
  },
  // Note: Workers AI native edge binding on account 379570860738dd1757ba7f67ef2bdffe currently encounters
  // Cloudflare internal error 10021 during version generation. The Worker automatically falls back to
  // calling the active Cloudflare Workers AI REST API on DAVID江江江 when CLOUDFLARE_API_TOKEN is set.
  // "ai": { "binding": "AI" },
  "observability": {
    "enabled": true
  }
}
